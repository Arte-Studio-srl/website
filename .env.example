# Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# REQUIRED - Authentication
# ============================================

# Secret key for JWT tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-secure-secret-key-here

# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com

# ============================================
# REQUIRED - Email (SMTP)
# ============================================

SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
CONTACT_FROM=Website <no-reply@yourdomain.com>
CONTACT_TO=owner@yourdomain.com

# ============================================
# REQUIRED - Database (PostgreSQL)
# ============================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/website

# ============================================
# REQUIRED - AWS S3
# ============================================
AWS_REGION=your-region
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET_NAME=your-bucket-name

# ============================================
# OPTIONAL - Environment
# ============================================

# Set to 'production' in production deployments
NODE_ENV=development
