# Sanity (public site reads + Studio CLI)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-02-25

# Contact form (Cloudflare Pages Function — see functions/api/contact.ts).
# These are set in the Cloudflare Pages dashboard, NOT in this file, for
# the deployed site. They are listed here for local reference only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM=Website <no-reply@yourdomain.com>
CONTACT_TO=owner@yourdomain.com

# RATE_LIMITER is a Cloudflare Rate Limiting binding. It is configured in
# the Cloudflare Pages dashboard (Settings → Functions → Bindings); there
# is no env-var equivalent for local development.

# Canonical site URL for SEO (sitemap, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional: write token for the one-off Sanity import script
# (scripts/sanity-import/import.mjs). Do not commit this value.
# SANITY_AUTH_TOKEN=sk_xxxxxxxxxxxx
