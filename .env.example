# Sanity (public site reads + Studio CLI)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-02-25

# The contact form is handled by workers/contact. Its Email and Rate Limiting
# bindings are declared in workers/contact/wrangler.jsonc; no mail API secret
# is stored in this project.

# Canonical site URL for SEO (sitemap, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional: write token for the one-off Sanity import script
# (scripts/sanity-import/import.mjs). Do not commit this value.
# SANITY_AUTH_TOKEN=sk_xxxxxxxxxxxx
